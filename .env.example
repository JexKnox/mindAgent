# 复制为 .env 并填写（.env 已被 gitignore，不会入库）

# LLM 服务的 API Key（必填）
LLM_API_KEY=sk-xxxx

# OpenAI 兼容 API 地址（可选，默认 OpenAI 官方）
# 火山方舟（豆包）: https://ark.cn-beijing.volces.com/api/v3
# DeepSeek:         https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型 ID（可选，默认 gpt-4o-mini）
# 火山方舟示例: doubao-seed-1-6-250615
# DeepSeek 示例: deepseek-chat
LLM_MODEL=gpt-4o-mini
