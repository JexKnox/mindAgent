# 复制为 .env 并填写（.env 已被 gitignore，不会入库）

# LLM 服务的 API Key（必填）
LLM_API_KEY=sk-xxxx

# OpenAI 兼容 API 地址（可选，默认 OpenAI 官方）
# 火山方舟（豆包）: https://ark.cn-beijing.volces.com/api/v3
# DeepSeek:         https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型 ID（可选，默认 gpt-4o-mini）
# 火山方舟示例: doubao-seed-1-6-250615
# DeepSeek 示例: deepseek-chat
LLM_MODEL=gpt-4o-mini

# Embedding 模型 ID（可选，用于长期记忆向量化，默认 text-embedding-3-small）
# 火山方舟示例: doubao-embedding-large-text-240915
LLM_EMBEDDING_MODEL=text-embedding-3-small

# ---- 记忆系统（均可选）----

# 长期记忆向量库持久化文件
#MEMORY_FILE=./data/memories.json
# 每轮注入的相关长期记忆条数
#MEMORY_TOP_K=5
# 是否开启每轮对话后的自动记忆抽取（true/false）
#MEMORY_AUTO_EXTRACT=true
# 短期记忆窗口（消息条数），超过则自动摘要压缩
#MEMORY_WINDOW=40
